###task Outbox Pattern — MongoDB + Redis####

import mongoose from "mongoose";
import Redis from "ioredis";

const redis = new Redis();

const User = mongoose.model(
  "User",
  new mongoose.Schema({
    name: String,
  })
);

const Outbox = mongoose.model(
  "Outbox",
  new mongoose.Schema({
    type: String,
    payload: Object,
    processed: {
      type: Boolean,
      default: false,
    },
  })
);

// Write to DB + Outbox
async function updateUser(userId: string, name: string) {
  const session = await mongoose.startSession();

  try {
    session.startTransaction();

    // 1. Update MongoDB
    await User.findByIdAndUpdate(
      userId,
      { name },
      { session }
    );

    // 2. Create Outbox event
    await Outbox.create(
      [
        {
          type: "USER_UPDATED",
          payload: {
            userId,
            name,
          },
        },
      ],
      { session }
    );

    // Both operations succeed together
    await session.commitTransaction();

    console.log("DB + Outbox saved successfully");
  } catch (error) {
    await session.abortTransaction();
    throw error;
  } finally {
    session.endSession();
  }
}

async function processOutbox() {
  const events = await Outbox.find({
    processed: false,
  });

  for (const event of events) {
    try {
      if (event.type === "USER_UPDATED") {
        const { userId, name } = event.payload as {
          userId: string;
          name: string;
        };

        // Update Redis
        await redis.set(
          `user:${userId}`,
          JSON.stringify({ userId, name })
        );

        // Mark event as processed
        event.processed = true;
        await event.save();
      }
    } catch (error) {
      console.error("Failed to process event:", error);
    }
  }
}

